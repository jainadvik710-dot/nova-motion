VIDEO_PROVIDER=replicate
# Create this token in your Replicate account. Never put it in frontend code.
REPLICATE_API_TOKEN=
# Use a Replicate model slug, for example wan-video/wan-2.6-t2v.
# The selected model must support prompt, duration, and size inputs.
REPLICATE_MODEL=wan-video/wan-2.6-t2v
# Optional: use a separate model for image-to-video. Leave blank to use REPLICATE_MODEL.
REPLICATE_IMAGE_MODEL=
# Most models use "image" for their starting-image input.
REPLICATE_IMAGE_INPUT_KEY=image
VIDEO_JOB_TIMEOUT=10m
PORT=3000
